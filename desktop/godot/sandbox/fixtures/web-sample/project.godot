; Fixed sandbox fixture project. Trusted, tiny and hash-stable; it is never a
; model-authored project.
config_version=5

[application]

config/name="Sandbox Web Fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://sandbox_probe/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
