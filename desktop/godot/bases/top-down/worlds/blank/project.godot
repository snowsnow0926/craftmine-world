; Top-down base project template.
; tools/new-world.mjs fills the placeholders and writes project.godot into
; the new world directory. A world is a standalone Godot project: its scripts,
; scenes, maps and assets are all editable, and its user:// directory is derived
; from its own world id, so two worlds never share progress.
config_version=5

[application]

config/name="空白起点"
config/description="Top-down blank start"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="craftmine-topdown-example-blank"
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/base/game.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
