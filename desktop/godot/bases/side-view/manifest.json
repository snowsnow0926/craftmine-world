{
  "format": "craftmine.godot-base/1",
  "baseId": "side-view",
  "baseVersion": "1.0.0",
  "godotVersion": "4.7.2-stable",
  "language": "GDScript",
  "renderer": "gl_compatibility",
  "status": "delivered-example-and-blank-start",
  "contract": {
    "format": "craftmine.godot-base-contract/1",
    "assets": {
      "manifest": "assets/ASSET_MANIFEST.json",
      "provenance": "docs/assets-and-provenance.md",
      "license": "docs/assets-and-provenance.md",
      "generator": null
    },
    "state": {
      "format": "craftmine.godot-sideview-state/1",
      "version": 1,
      "preserved": [
        "worldId",
        "player",
        "abilities",
        "checkpoints",
        "activeCheckpoint",
        "rewards",
        "rooms",
        "counters",
        "inventory",
        "entities",
        "vitals"
      ],
      "migrations": []
    }
  },
  "entryScene": "res://scenes/main.tscn",
  "protocols": {
    "worldFormat": "craftmine.godot-sideview-world/1",
    "stateFormat": "craftmine.godot-sideview-state/1",
    "paramsFormat": "craftmine.godot-sideview-params/1",
    "probeFormat": "craftmine.godot-sideview-probe/1",
    "runFormat": "craftmine.godot-sideview-run/1",
    "inputPlanFormat": "craftmine.godot-sideview-input-plan/1",
    "gateReportFormat": "craftmine.godot-sideview-gate/1",
    "progressFormat": "craftmine.progress/1",
    "baseProtocolVersion": 1
  },
  "worlds": {
    "blank": {
      "directory": "worlds/blank",
      "kind": "blank-start",
      "entryScene": "res://scenes/main.tscn",
      "description": "One flat room with the base runtime only: run, jump, platform collision, camera, basic attack and one save file. No checkpoint, target, reward or ability."
    },
    "ruins": {
      "directory": "worlds/ruins",
      "kind": "example",
      "entryScene": "res://scenes/main.tscn",
      "description": "Three connected rooms with return paths, a one-time cache, a training dummy, a breakable crate, a double-jump pickup and a 190 px high ledge that only a double jump can clear."
    }
  },
  "templates": [
    {
      "id": "blank",
      "kind": "blank-start",
      "label": "Blank start",
      "entryScene": "res://scenes/main.tscn",
      "source": "worlds/blank",
      "description": "One flat room with the base runtime only: run, jump, platform collision, camera, basic attack and one save file. No checkpoint, target, reward or ability.",
      "initialState": {
        "room": "start",
        "abilities": [],
        "checkpoints": [],
        "rewards": [],
        "targets": [],
        "counters": {},
        "inventory": {},
        "entities": {}
      }
    },
    {
      "id": "ruins",
      "kind": "example",
      "label": "Small ruins",
      "entryScene": "res://scenes/main.tscn",
      "source": "worlds/ruins",
      "description": "Three connected rooms with return paths, a one-time cache, a training dummy, a breakable crate, a double-jump pickup and a 190 px high ledge that only a double jump can clear.",
      "initialState": {
        "room": "entrance",
        "abilities": [],
        "checkpoints": [],
        "rewards": [],
        "targets": "authored health",
        "counters": {},
        "inventory": {},
        "entities": {}
      }
    }
  ],
  "components": [
    {
      "id": "sv.room-door",
      "version": 1,
      "kind": "entity",
      "label": "Room door",
      "compatibleBases": ["side-view"],
      "identity": { "scheme": "id in world.json room.doors", "field": "id", "fallback": "none" },
      "persistentState": {
        "format": "craftmine.godot-sideview-state/1",
        "fields": ["rooms[].visits"],
        "capture": "WorldState.to_dict()",
        "restore": "WorldState.apply_dict()"
      },
      "initialState": { "armed": false },
      "files": ["scripts/world/room_door.gd", "worlds/ruins/world.json"]
    },
    {
      "id": "sv.checkpoint",
      "version": 1,
      "kind": "entity",
      "label": "Checkpoint",
      "compatibleBases": ["side-view"],
      "identity": { "scheme": "id in world.json room.checkpoints", "field": "id", "fallback": "none" },
      "persistentState": {
        "format": "craftmine.godot-sideview-state/1",
        "fields": ["checkpoints", "activeCheckpoint"],
        "capture": "WorldState.to_dict()",
        "restore": "WorldState.apply_dict()"
      },
      "initialState": { "activated": false },
      "files": ["scripts/world/checkpoint.gd"]
    },
    {
      "id": "sv.ability-pickup",
      "version": 1,
      "kind": "entity",
      "label": "Ability pickup",
      "compatibleBases": ["side-view"],
      "identity": { "scheme": "id in world.json room.abilities", "field": "id", "fallback": "none" },
      "persistentState": {
        "format": "craftmine.godot-sideview-state/1",
        "fields": ["abilities", "rewards"],
        "capture": "WorldState.to_dict()",
        "restore": "WorldState.apply_dict()"
      },
      "initialState": { "taken": false },
      "files": ["scripts/world/pickup.gd", "worlds/ruins/world.json"]
    },
    {
      "id": "sv.reward-pickup",
      "version": 1,
      "kind": "entity",
      "label": "One-time reward pickup",
      "compatibleBases": ["side-view"],
      "identity": { "scheme": "id in world.json room.rewards", "field": "id", "fallback": "none" },
      "persistentState": {
        "format": "craftmine.godot-sideview-state/1",
        "fields": ["rewards", "counters", "inventory"],
        "capture": "WorldState.to_dict()",
        "restore": "WorldState.apply_dict()"
      },
      "initialState": { "taken": false },
      "files": ["scripts/world/pickup.gd"]
    },
    {
      "id": "sv.target",
      "version": 1,
      "kind": "entity",
      "label": "Target / breakable",
      "compatibleBases": ["side-view"],
      "identity": { "scheme": "id in world.json room.targets", "field": "id", "fallback": "none" },
      "persistentState": {
        "format": "craftmine.godot-sideview-state/1",
        "fields": ["entities[].health", "rewards", "counters", "inventory"],
        "capture": "WorldState.to_dict()",
        "restore": "WorldState.apply_dict()"
      },
      "initialState": { "health": "authored health", "rewarded": false },
      "files": ["scripts/world/target.gd", "worlds/ruins/world.json"]
    },
    {
      "id": "sv.hazard",
      "version": 1,
      "kind": "entity",
      "label": "Hazard",
      "compatibleBases": ["side-view"],
      "identity": { "scheme": "id in world.json room.hazards", "field": "id", "fallback": "none" },
      "persistentState": {
        "format": "craftmine.godot-sideview-state/1",
        "fields": ["vitals", "player"],
        "capture": "WorldState.to_dict()",
        "restore": "WorldState.apply_dict()"
      },
      "initialState": { "active": true },
      "files": ["scripts/world/hazard.gd", "worlds/ruins/world.json"]
    },
    {
      "id": "sv.spawn",
      "version": 1,
      "kind": "entity",
      "label": "Spawn point",
      "compatibleBases": ["side-view"],
      "identity": { "scheme": "id in world.json room.spawns", "field": "id", "fallback": "none" },
      "persistentState": {
        "format": "craftmine.godot-sideview-state/1",
        "fields": ["player.roomId", "player.x", "player.y"],
        "capture": "WorldState.to_dict()",
        "restore": "WorldState.apply_dict()"
      },
      "initialState": { "x": "authored", "y": "authored", "facing": 1 },
      "files": ["scripts/world/room.gd"]
    }
  ],
  "capabilities": [
    "gravity",
    "run-and-air-control",
    "jump-with-coyote-time-and-buffer",
    "variable-jump-height",
    "platform-collision",
    "room-bounded-camera",
    "basic-attack-hitbox",
    "checkpoint-and-respawn",
    "hazard-death",
    "one-time-ability-pickup",
    "one-time-reward-pickup",
    "room-transition-with-return-path",
    "persistent-abilities-checkpoints-rooms-rewards",
    "atomic-save-with-backup-recovery"
  ],
  "abilities": [
    {
      "id": "double_jump",
      "grantedBy": "worlds/ruins ability pickup",
      "effect": "second upward impulse while airborne",
      "persistent": true
    }
  ],
  "tools": {
    "verify": "tools/verify.mjs",
    "gateMetrics": "tools/gate-metrics.mjs",
    "newWorld": "tools/new-world.mjs",
    "inputPlans": "tools/plans/"
  },
  "stateVersion": 1,
  "entityIdScheme": "stable string id declared in world data, never a node path",
  "hostBoundary": {
    "writesOutsideSaveDirectory": false,
    "startsGodotProcesses": false,
    "buildsOrExports": false,
    "readsHostCredentials": false,
    "testInterface": "headless verifier is dormant unless CRAFTMINE_SIDEVIEW_INPUT_PLAN is set; it can press buttons and read the probe, never write player state"
  },
  "branchProposals": {
    "digSandbox": {
      "document": "docs/sandbox-branch-interface.md",
      "status": "proposal-only-not-implemented"
    }
  }
}
