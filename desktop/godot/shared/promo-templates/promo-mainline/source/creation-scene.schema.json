{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "craftmine.creation-scene/1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "defaults": {
      "type": "object",
      "properties": {
        "timeOfDay": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        }
      },
      "required": [
        "timeOfDay"
      ],
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "tree",
              "rock",
              "chest",
              "door",
              "marker"
            ]
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -28,
                "maximum": 28
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 16
              },
              {
                "type": "number",
                "minimum": -28,
                "maximum": 28
              }
            ],
            "minItems": 3,
            "maxItems": 3
          },
          "rotationY": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "scale": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4
            },
            "minItems": 3,
            "maxItems": 3
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          },
          "parameters": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "position",
          "rotationY",
          "scale",
          "color",
          "parameters"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tree"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "rock"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "chest"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "rewardId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "rewardCount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 99
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "door"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "initiallyOpen": {
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "marker"
                }
              }
            },
            "then": {
              "properties": {
                "parameters": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "maxLength": 80
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      },
      "maxItems": 128
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "const": "sequence-door"
          },
          "doorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "minItems": 2,
            "maxItems": 16,
            "uniqueItems": true
          },
          "script": {
            "type": "string",
            "pattern": "^scripts/creation/rules/[a-z][a-z0-9_-]{0,63}\\.gd$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "kind",
          "doorId",
          "sequence",
          "script",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 8
    }
  },
  "required": [
    "format",
    "revision",
    "defaults",
    "entities"
  ],
  "additionalProperties": false
}
