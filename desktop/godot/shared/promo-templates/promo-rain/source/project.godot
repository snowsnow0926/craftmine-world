config_version=5

[application]
config/name="Craftmine Creation Sandbox"
config/version="1.0.0"
run/main_scene="res://scenes/creation.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.55,0.72,0.86,1)

[autoload]
CraftmineRuntime="*res://craftmine_shared/runtime_bridge.gd"

[craftmine]
runtime/enabled=true
runtime/world_id="promo-rain"
runtime/adapter="res://craftmine_shared/base_adapter.gd"
