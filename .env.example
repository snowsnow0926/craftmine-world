# Optional process environment variables. This file is NOT auto-loaded.
# PowerShell example: $env:CRAFTMINE_PORT = '8787'
#
# 更省事的做法：把变量写进数据目录里的 secrets.json（默认 .craftmine/secrets.json）。
# 服务启动时自动读取，已存在的环境变量优先；该目录已被 .gitignore 忽略，也不进入源码归档。
# 例如：{ "CRAFTMINE_DEEPSEEK_API_KEY": "sk-...", "CRAFTMINE_MODEL_PROVIDER": "deepseek" }
CRAFTMINE_PORT=8787

# 模型后端：deepseek 或 codex。未设置时按是否配置了 DeepSeek 密钥推断（有密钥走 deepseek）。
# CRAFTMINE_MODEL_PROVIDER=deepseek
# DeepSeek 官方 API 密钥（只在服务端进程里读取，不要写进项目文件或页面）
# CRAFTMINE_DEEPSEEK_API_KEY=sk-你的密钥
# 可选模型 ID；deepseek 默认使用 deepseek-v4.1-flash-expires-on-0910
# CRAFTMINE_MODEL=deepseek-v4.1-flash-expires-on-0910
# 思考模式：默认关闭（思考 token 与答案共用输出预算，容易返回空内容）。复杂任务可设为 on。
# CRAFTMINE_THINKING=on
# 思考强度（开启思考时生效）：low | medium | high，默认 high
# CRAFTMINE_REASONING_EFFORT=high
# 单次生成的最大输出 token（256–384000）；关闭思考默认 32000，开启思考默认 64000
# CRAFTMINE_MAX_TOKENS=64000
# 单个任务的总时限（毫秒）；开启思考时默认 1200000，关闭时 240000
# CRAFTMINE_TASK_TIMEOUT_MS=1200000

# CRAFTMINE_CODEX_PATH=C:\path\to\codex.exe
# CRAFTMINE_DATA_DIR=D:\path\to\separate-project-data
# CRAFTMINE_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
# PLAYWRIGHT_MODULE_PATH=C:\path\to\node_modules\playwright
