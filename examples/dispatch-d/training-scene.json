        "ranged@1",
        "melee@1"
      ],
      "binding": null,
      "keys": [],
      "code": "export function step({frame,state}) {\n      if(frame.event.type==='start')return {state,commands:[{type:'inventory.define',item:'training-token',name:'训练币',description:'花园训练奖励'},{type:'inventory.add',item:'training-token',count:1}]};\n      const target=frame.objects.find(o=>o.id==='training-target');\n      if(!state.claimed&&target?.health===0)return {state:{...state,claimed:true},commands:[{type:'inventory.add',item:'training-token',count:1}]};\n      return {state,commands:[]};\n    }"
    },
