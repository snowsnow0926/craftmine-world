# Runtime integrity hashes use the same source bytes on Windows and Unix.
*.mjs text eol=lf
*.js text eol=lf
# Blender embeds these bytes into the broker and stages the same Git source.
desktop/blender/bridge/** text eol=lf
desktop/blender/toolchain.lock.json text eol=lf
# Release source pins refer to the exact Git blob bytes, including line endings.
desktop/godot/bases/** text=auto eol=lf
desktop/godot/shared/** text=auto eol=lf
desktop/godot/web/** text=auto eol=lf
desktop/godot/bases/**/*.png binary
desktop/godot/bases/**/*.jpg binary
desktop/godot/bases/**/*.ogg binary
desktop/godot/bases/**/*.wav binary
desktop/godot/probes/** text eol=lf
desktop/godot/licenses/** -text
desktop/delivery/licensing/texts/** -text
docs/evidence/godot-cycle-*/** -text whitespace=cr-at-eol
docs/evidence/immersive-20260911/** -text whitespace=cr-at-eol,-blank-at-eof

desktop/godot/sandbox/evidence/** -text whitespace=cr-at-eol

# Imported evidence and patch context retain exact whitespace from their tools.
desktop/godot/sandbox/evidence/tests.log -text whitespace=cr-at-eol,-blank-at-eof
docs/dispatch-reports/godot-parallel/**/evidence/*.txt -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/dispatch-reports/godot-parallel/**/evidence/**/*.log -text whitespace=cr-at-eol,-blank-at-eof
docs/dispatch-reports/godot-parallel/C/integration.patch -text whitespace=cr-at-eol,-blank-at-eol

docs/dispatch-reports/plan-loop/pp2-base-default/**/report.json -text
docs/dispatch-reports/plan-loop/pp2-base-default/**/*.log -text

# Player attachments and hash-indexed dispatch records retain their source bytes.
docs/assets/user-feedback-20260910/** -text whitespace=cr-at-eol
docs/dispatch-prompts/player-feedback-20260910/** -text whitespace=cr-at-eol
docs/dispatch-prompts/player-feedback-20260910/ALL_PROMPTS.md whitespace=cr-at-eol,-blank-at-eof

# Native replay fixtures are compared to the original full-file SHA256.
tests/godot-remaining/C/fixtures/native-import-task.log -text whitespace=cr-at-eol
docs/evidence/next-batch-nb1/** -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/gu6-performance-host-20260912/** -text
docs/evidence/fb02-floor-contact-20260912/** -text
desktop/godot/shared/engine_performance.gd -text
desktop/godot/shared/runtime_bridge_engine_v1.gd -text
desktop/godot/components/approved-pomeranian/** text eol=lf
desktop/godot/components/approved-pomeranian/*.glb binary
desktop/godot/components/approved-pomeranian/*.png binary
# Published templates retain native formal-source hashes, including mixed endings.
desktop/godot/shared/promo-templates/** -text whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol
